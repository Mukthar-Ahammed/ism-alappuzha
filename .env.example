# Copy to .env.local for local development. On Netlify, set the same names under
# Site configuration > Environment variables. Never commit real values.

# Supabase project (Project Settings > API). The URL is the project origin, e.g.
# https://abcdefghijklmnop.supabase.co (a trailing /rest/v1/ is tolerated but not needed).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key: safe in the browser, limited by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: server only. Netlify: scope it to "Functions" and "Builds".
SUPABASE_SECRET_KEY=

# Public address of the site, used for canonical links, the sitemap and social previews.
# Optional on Netlify: the primary domain (Netlify's URL variable) is used when unset.
NEXT_PUBLIC_SITE_URL=https://ismalappuzha.org
